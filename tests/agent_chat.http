### @name multi_product_parallel_and_sequential
# Multi-product drilldown: parallel GA+GSC overviews + sequential Ads ROI winner then daily
POST {{baseUrl}}/chat
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "messages": [
    {
      "role": "user",
      "content": "For Jan 2025, show GA overall and GSC overall. Also, identify the Ads campaign with the highest ROI and provide its daily breakdown."
    }
  ]
}

### @name invalid_dates_expect_automated_handling
# Invalid dates (end before start) — expect automated correction/handling
POST {{baseUrl}}/chat
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "messages": [
    {
      "role": "user",
      "content": "Show GA daily from 2025-02-01 to 2025-01-01."
    }
  ]
}

### @name history_check
# History check for anonymous user (no auth)
GET {{baseUrl}}/chat/histories
Content-Type: application/json
Authorization: Bearer {{token}}

### @name history_detail_check
# History detail check for anonymous user (no auth)
GET {{baseUrl}}/chat/history/d6cba914-d17c-4a53-bc67-f22830635ec0?user_id=anonymous
Content-Type: application/json
Authorization: Bearer {{token}}
